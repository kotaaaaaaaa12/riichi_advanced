{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riichi-advanced",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "RiichiServer",
      "image": "./Dockerfile.cloudflare",
      "instance_type": "basic",
      "max_instances": 1,
      "constraints": { "regions": ["APAC"] }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RIICHI_SERVER", "class_name": "RiichiServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RiichiServer"] }]
}
